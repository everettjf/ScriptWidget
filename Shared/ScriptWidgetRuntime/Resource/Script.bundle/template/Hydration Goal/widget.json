      "systemImage": "drop.fill",
      "actionID": "addGlass"
    },
    {
      "id": "undoRecord",
      "type": "button",
      "title": "Undo last water change",
      "systemImage": "arrow.uturn.backward",
      "actionID": "undoRecord"
    },
    {
      "id": "resetToday",
